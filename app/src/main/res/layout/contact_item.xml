<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@+id/profile_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/outline_account_circle_24"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toLeftOf="@id/contact_name"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <TextView
        android:id="@+id/contact_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Augstine Leonard"
        app:layout_constraintLeft_toRightOf="@id/profile_icon"
        app:layout_constraintBottom_toTopOf="@id/contact_phone_number"
        app:layout_constraintTop_toTopOf="parent"
        />
    <TextView
        android:id="@+id/contact_phone_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+255 677 930673"
        app:layout_constraintLeft_toRightOf="@id/profile_icon"
        app:layout_constraintTop_toBottomOf="@id/contact_name"
        />

</androidx.constraintlayout.widget.ConstraintLayout>